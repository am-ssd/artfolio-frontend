NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-15
NEXT_PUBLIC_SANITY_USE_CDN=false

# Optional but recommended: Viewer/Editor token so unpublished Studio edits
# (category background images) show on the site before you click Publish.
# Create at https://www.sanity.io/manage → Project → API → Tokens
SANITY_API_READ_TOKEN=
# Used for contact submissions / draft preview fallback
SANITY_API_WRITE_TOKEN=

# Gmail SMTP for the contact form
# 1) Enable 2-Step Verification on GMAIL_USER
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste the 16-character code below (spaces OK), then restart `npm run dev`
GMAIL_USER=web3designer1222@gmail.com
GMAIL_APP_PASSWORD=
# Optional override; defaults to GMAIL_USER
CONTACT_TO_EMAIL=web3designer1222@gmail.com
